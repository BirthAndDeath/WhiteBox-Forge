        width: 1560px;
        height: 760px;
        border-radius: 28px;
        background: clr.panel;
        border-width: 2px;
        border-color: clr.panelb;

        Rectangle {
            x: 26px;
            y: 26px;
            width: 720px;
            height: 420px;
            border-radius: 22px;
            background: clr.ad1;
            border-width: 1px;
            border-color: clr.ad1b;
